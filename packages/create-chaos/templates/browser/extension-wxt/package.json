{
  "name": "browser-extension-scaffold",
  "description": "基于 WXT、React 和 TypeScript 的浏览器扩展脚手架。",
  "homepage": "https://github.com/chaos-design/chaos#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaos-design/chaos.git"
  },
  "bugs": {
    "url": "https://github.com/chaos-design/chaos/issues"
  },
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "setup": "node scripts/setup-project.mjs",
    "compile": "tsc --noEmit",
    "check": "biome lint . && tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "0.2.4",
    "lucide-react": "^1.41.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wxt": "^0.21.3"
  }
}
