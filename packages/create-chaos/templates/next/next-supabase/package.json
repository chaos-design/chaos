{
  "name": "next-supabase-scaffold",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "next build",
    "start": "node scripts/run-next.mjs start",
    "config:show": "node scripts/scaffold-config.mjs show",
    "config:port": "node scripts/scaffold-config.mjs set-port",
    "config:sync": "node scripts/scaffold-config.mjs sync",
    "create:project": "bash scripts/create-project.sh",
    "setup:project": "bash scripts/setup-project.sh",
    "setup:supabase": "node scripts/configure-supabase.mjs",
    "supabase:start": "pnpm config:sync && supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:link": "supabase link",
    "supabase:db:push": "supabase db push --linked",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.17.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "supabase": "2.114.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  }
}
