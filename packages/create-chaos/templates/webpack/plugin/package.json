{
  "name": "@chaos-design/webpack-plugin",
  "private": true,
  "version": "0.0.1",
  "files": [
    "lib",
    "index.d.ts"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "development": "./src/index.ts",
    "types": "./lib/index.d.ts",
    "import": "./lib/index.js",
    "require": "./lib/index.js"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "preinstall": "npx only-allow pnpm",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "release": "bumpp package.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@types/node": "^25.0.10",
    "bumpp": "^10.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "webpack": "^5.104.1"
  }
}
