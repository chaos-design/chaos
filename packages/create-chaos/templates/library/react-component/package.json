{
  "name": "vite-react-typescript-starter",
  "type": "module",
  "version": "0.0.1",
  "private": false,
  "description": "React component library created by create-chaos",
  "author": "Rain120",
  "license": "MIT",
  "keywords": [],
  "files": [
    "lib"
  ],
  "main": "./lib/index.cjs.js",
