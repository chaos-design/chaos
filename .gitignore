# macOS
.DS_Store

# WorkBuddy workspace data
.workbuddy/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov
lib

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/
.pnpm-store/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm
/.validation-cache/

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp
.cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# for get changed pkg path
cache-changed-pkg-path.sh
package-lock.json

# Template build artifacts that must never be committed or published.
# Templates are shipped inside the create-chaos tarball, so any stray build
# output would leak into npm and into every scaffolded project.
packages/create-chaos/templates/**/node_modules/
packages/create-chaos/templates/**/.wxt/
packages/create-chaos/templates/**/dist/
packages/create-chaos/templates/**/.output/
packages/create-chaos/templates/**/coverage/
packages/create-chaos/templates/**/*.tsbuildinfo
packages/create-chaos/templates/**/next-env.d.ts
# `lib` is source in several templates, so it is only ignored where it is output.
packages/create-chaos/templates/webpack/plugin/lib/
packages/create-chaos/templates/vscode/extension/lib/

# Source files used by the Next.js template
!packages/create-chaos/templates/react/next-shadcn/lib/
!packages/create-chaos/templates/react/next-shadcn/lib/**
!packages/create-chaos/templates/browser/extension-wxt/lib/
!packages/create-chaos/templates/browser/extension-wxt/lib/**
!packages/create-chaos/templates/react/next-supabase/src/lib/
!packages/create-chaos/templates/react/next-supabase/src/lib/**

# `site` is the deployable Next.js app; its `src/lib` is source (holds the
# `cn` helper at `@/lib/utils`), not build output, so it must not be swallowed
# by the bare `lib` rule above.
!site/src/lib/
!site/src/lib/**
