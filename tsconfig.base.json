{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "chaos",
  "_version": "0.0.23",
  "_note": "Vendored from @chaos-design/tsconfig@0.0.23 (MIT). That package was unpublished from npm, which broke `pnpm install --frozen-lockfile` in CI. Restore the dependency once it is republished.",

  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  }
}
